#!/system/bin/sh
# Control CLI for the CMF Phone 1 stereo module.
# Run from Termux (su) or adb shell (su).

MODDIR=${MODDIR:-/data/adb/modules/cmf_stereo}
. "$MODDIR/scripts/common.sh"

usage() {
  cat <<'USAGE'
stereoctl - CMF Phone 1 stereo speaker control

  status              show module, daemon and control state
  doctor              diagnose why the earpiece is silent
  reset               clear saved state and start clean
  probe [dir]         dump the audio hardware to /sdcard (or dir)
  report              fold the newest probe into one shareable .txt
  on | off            arm / disarm the module (survives reboot)
  solo                speaker off, earpiece only - for auditioning
  unsolo              back to normal
  guard on | off      re-enable / bypass the speaker-follows guard
  apply | revert      one-shot apply or restore of the configured actions
  restart             restart the watcher daemon
  log [n]             tail the log (default 50 lines)
  edit                print the config paths so you can edit them

  scan [pattern]      search the mixer for candidate controls
                      (default pattern: receiver|earpiece|rcv|handset|spk)
  ctl NAME [VALUE]    read or write a single mixer control
  dump                dump every mixer control and its value
  diff [seconds]      snapshot the mixer, wait, then show what changed
                      (start or stop playback during the wait - this is how
                      you find which controls actually carry media)

  xml-patch           overlay a Speaker-port-stereo audio policy (reboot)
  xml-revert          remove that overlay (reboot)

Config lives in /data/adb/cmf-stereo/ and survives module updates.
USAGE
}

cmd_status() {
  echo "module:    $MODDIR"
  echo "config:    $CONF"
  echo "actions:   $ACTIONS ($(action_count) configured)"
  if module_active; then echo "armed:     yes"; else echo "armed:     no (disabled)"; fi
  echo "mode:      $MODE (interval ${WATCH_INTERVAL}s)"
  if _p=$(daemon_pid); then echo "daemon:    running (pid $_p)"; else echo "daemon:    not running"; fi
  if find_tinymix; then
    _st=$(tinymix_style)
    if [ "$_st" = unknown ]; then
      echo "tinymix:   $TINYMIX - UNUSABLE (wrong arch, or not executable)"
    else
      echo "tinymix:   $TINYMIX ($_st style)"
    fi
  else
    echo "tinymix:   NOT FOUND - mixer actions cannot run"
  fi
  if playback_active; then echo "playback:  active"; else echo "playback:  idle"; fi
  echo "boot:      $(boot_strikes) strike(s) since last successful boot"
  _ov=$(find "$MODDIR/system" -name 'audio_policy_configuration*.xml' 2>/dev/null | wc -l)
  echo "xml overlay: $_ov file(s)"
  if [ "$(action_count)" -gt 0 ]; then
    echo
    echo "current values:"
    action_lines | while IFS='|' read -r kind target value rest; do
      target=$(echo "$target" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      value=$(echo "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      case $kind in
        ctl)   _now=$(ctl_get "$target") ;;
        sysfs) _now=$(cat "$target" 2>/dev/null) ;;
        prop)  _now=$(getprop "$target") ;;
        *)     _now="?" ;;
      esac
      printf '  %-6s %-42s want=%-10s now=%s\n' "$kind" "$target" "$value" "${_now:-<missing>}"
    done
  fi
}

# Chat and mail clients routinely refuse .tar.gz. This folds the parts worth
# reading into a single plain text file that is easy to attach.
cmd_report() {
  # Pick the newest probe DIRECTORY. The plain glob also matches the tarball
  # sitting beside it, which sorts last and is not a directory.
  _dir=${1:-}
  if [ -z "$_dir" ]; then
    for _d in /sdcard/cmf-stereo-probe-*; do
      [ -d "$_d" ] && _dir=$_d
    done
  fi
  [ -n "$_dir" ] && [ -d "$_dir" ] || { echo "no probe report found - run: stereoctl probe"; return 1; }
  _out=/sdcard/cmf-stereo-report.txt
  {
    for f in SUMMARY.txt 00-device.txt 01-alsa.txt 02-mixer.txt 03-candidates.txt \
             04-amplifier.txt 06-speaker-port.txt 07-hal.txt 10-safety.txt \
             09-audio-param/index.txt; do
      [ -f "$_dir/$f" ] || continue
      echo "######## $f ########"
      cat "$_dir/$f"
      echo
    done
    for f in "$_dir"/05-hal-configs/*audio_policy_configuration*.xml; do
      [ -f "$f" ] || continue
      echo "######## $(basename "$f") ########"
      cat "$f"
      echo
    done
  } > "$_out" 2>&1
  chmod 0644 "$_out" 2>/dev/null
  echo "wrote $_out ($(du -h "$_out" 2>/dev/null | cut -f1), $(grep -c . "$_out") lines)"
  echo "source: $_dir"
}

cmd_scan() {
  find_tinymix || { echo "tinymix not found - see the README"; return 1; }
  _pat=${1:-'receiver|earpiece|rcv|handset|spk|speaker|mux|amp'}
  if [ "$(tinymix_style)" = new ]; then
    "$TINYMIX" contents 2>/dev/null | grep -iE "$_pat"
  else
    "$TINYMIX" 2>/dev/null | grep -iE "$_pat"
  fi
}

cmd_dump() {
  find_tinymix || { echo "tinymix not found - see the README"; return 1; }
  if [ "$(tinymix_style)" = new ]; then "$TINYMIX" contents 2>&1; else "$TINYMIX" 2>&1; fi
}

cmd_diff() {
  _n=${1:-20}
  find_tinymix || { echo "tinymix not found"; return 1; }
  _a=$DATADIR/snap.before
  _b=$DATADIR/snap.after
  mixer_snapshot "$_a" || { echo "could not read the mixer"; return 1; }
  echo "snapshot taken ($(grep -c . "$_a") controls)."
  echo "now change what you want to observe - start music, stop it, plug in"
  echo "headphones - you have ${_n}s."
  sleep "$_n"
  mixer_snapshot "$_b" || { echo "could not read the mixer"; return 1; }
  echo
  echo "controls that changed:"
  diff_snapshots "$_a" "$_b"
}

cmd_ctl() {
  [ -n "$1" ] || { echo "usage: stereoctl ctl NAME [VALUE]"; return 1; }
  if [ -n "$2" ]; then
    _before=$(ctl_get "$1")
    if ctl_set "$1" "$2"; then
      echo "$1: $_before -> $(ctl_get "$1")"
    else
      echo "failed to set '$1'"; return 1
    fi
  else
    _v=$(ctl_get "$1")
    [ -n "$_v" ] || { echo "no such control: $1"; return 1; }
    _raw=$(ctl_get_raw "$1")
    echo "$1 = $_v"
    # Show the raw line too when it carries more than the value: the enum
    # options, or an int's permitted range.
    [ "$_raw" != "$_v" ] && echo "  ($_raw)"
  fi
}

# Disarming has to stop the daemon, not just set the kill switch. A daemon
# left running keeps restoring saved originals underneath you, so a manual
# "stereoctl ctl ..." appears to succeed and is silently undone seconds later
# - which makes hand testing produce meaningless results.
# Audition the earpiece on its own. Bypasses the guard first, otherwise
# silencing the speaker amp silences the earpiece with it.
# Walks every layer that can silence the earpiece, in the order they apply,
# and says which one is responsible instead of leaving it to guesswork.
cmd_doctor() {
  _bad=0
  echo "1. module armed"
  if [ -f "$KILLSWITCH" ]; then
    echo "   NO - kill switch set (it survives reboots). Fix: stereoctl on"
    _bad=1
  else
    echo "   yes"
  fi

  echo "2. daemon"
  if _p=$(daemon_pid); then echo "   running (pid $_p)"
  else echo "   NOT running. Fix: stereoctl restart"; _bad=1; fi

  echo "3. tinymix"
  if find_tinymix && [ "$(tinymix_style)" != unknown ]; then
    echo "   $TINYMIX ($(tinymix_style))"
  else
    echo "   UNUSABLE - mixer writes cannot happen"; _bad=1
  fi

  echo "4. playback"
  echo "   detector: $(playback_detector)"
  if playback_active; then
    echo "   active"
  else
    echo "   IDLE - with MODE=playback nothing is applied until audio plays."
    echo "   Start music and run this again; everything below is meaningless"
    echo "   until then."
    _bad=1
  fi

  echo "5. guard"
  if [ -f "$DATADIR/guard_bypass" ]; then
    echo "   bypassed (solo mode)"
  elif [ -z "${GUARD_CTL:-}" ]; then
    echo "   none configured"
  else
    _g=$(ctl_get "$GUARD_CTL")
    if [ "$_g" = "$GUARD_VALUE" ]; then
      echo "   ok ($GUARD_CTL = $_g)"
    else
      echo "   BLOCKING: $GUARD_CTL = ${_g:-<missing>}, needs $GUARD_VALUE"
      echo "   This is what happens if you disable the speaker amp by hand."
      echo "   Fix: stereoctl solo   (or re-enable the amp)"
      _bad=1
    fi
  fi

  # A diagnostic that changes what it measures is a trap: applying here while
  # playback is idle silently switches the earpiece on, which reads as
  # "doctor fixed it" when nothing was broken.
  if ! playback_active; then
    echo "6. applying now"
    echo "   skipped - playback is idle, and applying would energise the"
    echo "   earpiece outside normal operation. Start audio and re-run."
    echo
    echo "Fix the items marked above, then run 'stereoctl doctor' again."
    return
  fi

  echo "6. applying now"
  apply_actions
  action_lines | while IFS='|' read -r kind target value rest; do
    target=$(echo "$target" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    value=$(echo "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    _now=$(ctl_get "$target" 2>/dev/null)
    if [ "$_now" = "$value" ]; then
      printf '   ok      %-34s = %s\n' "$target" "$_now"
    else
      printf '   FAILED  %-34s want %s, reads %s\n' "$target" "$value" "${_now:-<missing>}"
    fi
  done

  echo
  if [ "$_bad" -eq 0 ]; then
    echo "Everything applied. If it is still silent, the path is powered but"
    echo "inaudible - check Handset Volume and the media volume."
  else
    echo "Fix the items marked above, then run 'stereoctl doctor' again."
  fi
}

# Wipe remembered state. Saved originals are the one thing that survives a
# reinstall, and a bad one makes every revert restore a broken value.
cmd_reset() {
  if _p=$(daemon_pid); then kill "$_p" 2>/dev/null; sleep 1; fi
  rm -f "$STATEDIR"/* "$DATADIR/guard_bypass" "$DATADIR/solo_prev" \
        "$KILLSWITCH" "$PIDFILE" 2>/dev/null
  echo "cleared: saved originals, guard bypass, solo state, kill switch"
  cmd_restart
}

cmd_solo() {
  touch "$DATADIR/guard_bypass"
  if [ -n "${GUARD_CTL:-}" ]; then
    _was=$(ctl_get "$GUARD_CTL")
    printf '%s' "$_was" > "$DATADIR/solo_prev"
    # Anything that is not GUARD_VALUE means "off" for a two-state control.
    case $(ctl_get_raw "$GUARD_CTL") in
      *Disable*) ctl_set "$GUARD_CTL" Disable ;;
      *)         ctl_set "$GUARD_CTL" 0 ;;
    esac
    echo "speaker off ($GUARD_CTL was $_was), guard bypassed"
  else
    echo "guard bypassed (no GUARD_CTL configured)"
  fi
  echo "earpiece only - run 'stereoctl unsolo' when done"
}

cmd_unsolo() {
  rm -f "$DATADIR/guard_bypass"
  if [ -n "${GUARD_CTL:-}" ]; then
    _prev=$(cat "$DATADIR/solo_prev" 2>/dev/null)
    [ -z "$_prev" ] && _prev=$GUARD_VALUE
    ctl_set "$GUARD_CTL" "$_prev"
    rm -f "$DATADIR/solo_prev"
    echo "speaker restored to $_prev, guard active"
  else
    echo "guard active"
  fi
}

cmd_off() {
  touch "$KILLSWITCH"
  if _p=$(daemon_pid); then
    kill "$_p" 2>/dev/null
    _w=0
    while daemon_pid >/dev/null 2>&1 && [ $_w -lt 10 ]; do sleep 1; _w=$((_w + 1)); done
    rm -f "$PIDFILE"
    echo "daemon stopped"
  fi
  revert_actions
  echo "disarmed and reverted - controls are yours until 'stereoctl on'"
  echo "note: this survives a reboot. 'stereoctl on' to re-arm."
}

cmd_restart() {
  if _p=$(daemon_pid); then kill "$_p" 2>/dev/null; sleep 1; fi
  STARTUP_DELAY=0 nohup "$MODDIR/scripts/stereo-daemon.sh" >/dev/null 2>&1 &
  sleep 2
  if _p=$(daemon_pid); then echo "daemon restarted (pid $_p)"; else echo "daemon did not start - check: stereoctl log"; fi
}

case ${1:-status} in
  status)  cmd_status ;;
  probe)   sh "$MODDIR/scripts/probe.sh" "$2" ;;
  report)  cmd_report "$2" ;;
  on)      rm -f "$KILLSWITCH"; echo "armed"; cmd_restart ;;
  off)     cmd_off ;;
  doctor)  cmd_doctor ;;
  reset)   cmd_reset ;;
  solo)    cmd_solo ;;
  unsolo)  cmd_unsolo ;;
  guard)   case ${2:-status} in
             off)    touch "$DATADIR/guard_bypass"; echo "guard bypassed" ;;
             on)     rm -f "$DATADIR/guard_bypass"; echo "guard active" ;;
             *)      [ -f "$DATADIR/guard_bypass" ] && echo "guard: bypassed" \
                       || echo "guard: ${GUARD_CTL:-none} = ${GUARD_VALUE:-}" ;;
           esac ;;
  apply)   apply_actions; echo "applied"; ;;
  revert)  revert_actions; echo "reverted" ;;
  restart) cmd_restart ;;
  log)     tail -n "${2:-50}" "$LOGFILE" 2>/dev/null || echo "no log yet" ;;
  edit)    echo "$CONF"; echo "$ACTIONS" ;;
  scan)    cmd_scan "$2" ;;
  ctl)     shift; cmd_ctl "$@" ;;
  dump)    cmd_dump ;;
  diff)    cmd_diff "$2" ;;
  xml-patch)  sh "$MODDIR/scripts/xml_patch.sh" patch ;;
  xml-revert) sh "$MODDIR/scripts/xml_patch.sh" revert ;;
  -h|--help|help) usage ;;
  *)       echo "unknown command: $1"; echo; usage; exit 1 ;;
esac
